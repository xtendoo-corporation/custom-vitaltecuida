<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Registro de la página en el sistema website -->
        <record id="website_page_reviews" model="website.page">
            <field name="name">Reseñas</field>
            <field name="type">qweb</field>
            <field name="url">/reviews</field>
            <field name="website_published">True</field>
            <field name="key">vitaltecuida_website.reviews_page</field>
            <field name="is_published">True</field>
            <field name="website_indexed">True</field>
        </record>

        <!-- Menú simple para el sitio web -->
        <record id="menu_website_reviews" model="website.menu">
            <field name="name">Reseñas</field>
            <field name="url">/reviews</field>
            <field name="page_id" ref="website_page_reviews"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
            <field name="website_id" eval="False"/>
            <field name="is_visible">True</field>
            <field name="new_window">False</field>
        </record>
    </data>
</odoo>
