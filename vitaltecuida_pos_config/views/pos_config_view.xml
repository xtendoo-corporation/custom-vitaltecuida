<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_default_partner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.default.partner</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el campo debajo de la sección de clientes/facturas -->
            <xpath expr="//setting[@id='flexible_taxes']" position="before">
                <setting string="Cliente por defecto"
                         help="Cliente que se asignará automáticamente a cada nuevo pedido en esta caja.">
                    <field name="pos_default_partner_id" placeholder="Sin cliente por defecto"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
