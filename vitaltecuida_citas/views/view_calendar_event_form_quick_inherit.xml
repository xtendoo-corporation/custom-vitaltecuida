<odoo>
    <record id="view_calendar_event_form_inherit_resources" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.resources</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="resource_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

     <record id="view_calendar_event_form_inherit_resources_full" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.resources.full</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="resource_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

</odoo>
