<odoo>
    <!-- Vista formulario heredada para añadir campos personalizados -->
    <record id="view_calendar_event_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- Añadir tipo de cita después del campo de nombre -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="appointment_type_id"/>
            </xpath>
            <!-- Añadir recursos asignados en el grupo de información -->
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="resource_ids" widget="many2many_tags" options="{'color_field': 'color_index'}"/>
            </xpath>
        </field>
    </record>

    <!-- Vista calendario con colores de recursos -->
    <record id="view_calendar_event_simple" model="ir.ui.view">
        <field name="name">Resource Calendar View</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <calendar string="Resource Bookings"
                      color="resource_color_index"
                      date_start="start"
                      date_stop="stop"
                      mode="week"
                      event_open_popup="true"
                      quick_create="0"
                      create="0">
                <field name="name"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="resource_ids" widget="many2many_tags"/>
                <field name="appointment_type_id"/>
                <field name="resource_color_index" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- Vista de búsqueda con botón para crear cita -->
    <record id="view_calendar_event_search_inherit" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <group expand="0" string="Group By">
                    <filter string="Recursos" name="group_by_resource" context="{'group_by': 'resource_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista tree personalizada con botón para nueva cita -->
    <record id="view_calendar_event_tree_resource" model="ir.ui.view">
        <field name="name">calendar.event.tree.resource</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list string="Citas" create="false">
                <field name="name"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="resource_ids" widget="many2many_tags"/>
                <field name="appointment_type_id"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir la vista calendario -->
    <record id="action_calendar_event_resource" model="ir.actions.act_window">
        <field name="name">Resource Bookings</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva cita
            </p>
            <p>
                Haga clic en el botón "Nueva Cita" para programar una cita con recursos asignados.
            </p>
        </field>
        <field name="context">{
            'default_resource_ids': [],
            'from_resource_calendar': True,
        }</field>
    </record>

    <!-- Vista específica para calendario -->
    <record id="action_calendar_event_resource_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_calendar_event_simple"/>
        <field name="act_window_id" ref="action_calendar_event_resource"/>
    </record>

    <!-- Vista específica para tree -->
    <record id="action_calendar_event_resource_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_calendar_event_tree_resource"/>
        <field name="act_window_id" ref="action_calendar_event_resource"/>
    </record>

    <!-- Acción cliente para abrir wizard con botón flotante -->
    <record id="action_calendar_create_appointment" model="ir.actions.client">
        <field name="name">Nueva Cita</field>
        <field name="tag">display_notification</field>
        <field name="params" eval="{'title': 'Nueva Cita', 'message': 'Abriendo formulario de nueva cita...', 'sticky': False, 'type': 'info'}"/>
    </record>

    <!-- Acción servidor para abrir el wizard de creación -->
    <record id="action_open_appointment_wizard_from_calendar" model="ir.actions.server">
        <field name="name">Nueva Cita</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_view_types">calendar</field>
        <field name="state">code</field>
        <field name="code">
action = model.open_appointment_wizard()
        </field>
    </record>

    <!-- Menú dentro del módulo de Citas -->
    <menuitem id="menu_resource_bookings"
              name="Calendario de Citas"
              parent="appointment.main_menu_appointments"
              action="action_calendar_event_resource"
              sequence="30"/>

    <!-- Botón en el menú para crear cita con wizard -->
    <menuitem id="menu_create_appointment_wizard"
              name="Nueva Cita"
              parent="appointment.main_menu_appointments"
              action="action_calendar_event_wizard"
              sequence="40"/>
</odoo>
