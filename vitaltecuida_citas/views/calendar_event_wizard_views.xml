<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario del wizard de creación de citas -->
    <record id="view_calendar_event_wizard_form" model="ir.ui.view">
        <field name="name">calendar.event.wizard.form</field>
        <field name="model">calendar.event.wizard</field>
        <field name="arch" type="xml">
            <form string="Nueva Cita">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej: Consulta médica con Dr. García"/>
                            <field name="partner_id"
                                   options="{'no_create': False, 'no_open': False}"/>
                            <field name="appointment_type_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="start"/>
                            <field name="duration"/>
                            <field name="stop"/>
                            <field name="resource_ids"
                                   widget="many2many_tags"
                                   options="{'color_field': 'color_index', 'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Notas adicionales sobre la cita..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_event"
                            string="Crear"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_calendar_event_wizard" model="ir.actions.act_window">
        <field name="name">Nueva Cita</field>
        <field name="res_model">calendar.event.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_calendar_event_wizard_form"/>
    </record>

</odoo>

