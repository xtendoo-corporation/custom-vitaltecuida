<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit partner form view to add smart button -->
        <record id="view_partner_form_sign_documents" model="ir.ui.view">
            <field name="name">res.partner.form.sign.documents</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_sign_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            >
                        <field name="sign_request_count" widget="statinfo" string="Documentos Firmados"/>
                    </button>
                </div>
            </field>
        </record>

    </data>
</odoo>
