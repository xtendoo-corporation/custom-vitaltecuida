<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_sign_template_wizard_form" model="ir.ui.view">
        <field name="name">sign.template.wizard.form</field>
        <field name="model">sign.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar Plantilla de Firma">
                <group>
                    <field name="partner_id"/>
                    <field name="sign_template_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Firmar Ahora" name="action_sign_now" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

