<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_report_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.report.wizard.form</field>
        <field name="model">pos.session.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Informe Detallado de Sesiones POS">
                <group>
                    <group>
                        <field name="session_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="report_type"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Imprimir Informe"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_session_report_wizard" model="ir.actions.act_window">
        <field name="name">Informe Detallado de Sesiones</field>
        <field name="res_model">pos.session.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>

