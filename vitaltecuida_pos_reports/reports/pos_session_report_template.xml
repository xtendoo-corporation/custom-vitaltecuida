<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_session_detailed_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="data" t-value="o._get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Estilos para mejorar saltos de página -->
                        <style>
                            .order-block {
                                page-break-inside: avoid;
                                break-inside: avoid;
                            }
                            .session-section {
                                page-break-inside: avoid;
                            }
                            table {
                                page-break-inside: auto;
                            }
                            tr {
                                page-break-inside: avoid;
                                page-break-after: auto;
                            }
                            thead {
                                display: table-header-group;
                            }
                            tfoot {
                                display: table-footer-group;
                            }
                        </style>

                        <!-- Encabezado del informe -->
                        <div class="text-center mb-4">
                            <h2>Informe Detallado de Sesiones POS</h2>
                            <div t-if="data['date_from'] or data['date_to']">
                                <p>
                                    <t t-if="data['date_from']">
                                        Desde: <span t-out="data['date_from']" t-options="{'widget': 'datetime'}"/>
                                    </t>
                                    <t t-if="data['date_to']">
                                        Hasta: <span t-out="data['date_to']" t-options="{'widget': 'datetime'}"/>
                                    </t>
                                </p>
                            </div>
                        </div>

                        <!-- Resumen General -->
                        <div class="mb-4">
                            <h4 class="mb-3">Resumen General</h4>
                            <table class="table table-sm table-bordered">
                                <tr>
                                    <th>Total de Sesiones:</th>
                                    <td><span t-out="len(data['sessions_data'])"/></td>
                                    <th>Total de Pedidos:</th>
                                    <td><span t-out="data['grand_total_orders']"/></td>
                                </tr>
                                <tr>
                                    <th>Total Base Imponible:</th>
                                    <td><span t-out="data['grand_total'] - data['grand_total_tax']" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/></td>
                                    <th>Total Impuestos:</th>
                                    <td><span t-out="data['grand_total_tax']" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/></td>
                                </tr>
                                <tr>
                                    <th colspan="3" class="text-right">Total General:</th>
                                    <th><span t-out="data['grand_total']" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/></th>
                                </tr>
                            </table>
                        </div>

                        <!-- Resumen de Formas de Pago -->
                        <div class="mb-4">
                            <h5>Resumen de Formas de Pago</h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Método de Pago</th>
                                        <th class="text-right">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['grand_payment_summary'].items()" t-as="payment">
                                        <td><span t-out="payment[0]"/></td>
                                        <td class="text-right">
                                            <span t-out="payment[1]" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Resumen de Impuestos -->
                        <div class="mb-4" t-if="data['grand_tax_summary']">
                            <h5>Resumen de Impuestos</h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Impuesto</th>
                                        <th class="text-right">Base Imponible</th>
                                        <th class="text-right">Importe Impuesto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['grand_tax_summary'].items()" t-as="tax">
                                        <td><span t-out="tax[0]"/></td>
                                        <td class="text-right">
                                            <span t-out="tax[1]['base']" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-out="tax[1]['amount']" t-options="{'widget': 'monetary', 'display_currency': o.session_ids[0].currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Detalle por Sesión -->
                        <t t-foreach="data['sessions_data']" t-as="session_data">
                            <div class="page-break">
                                <h3 class="mt-4 mb-3">
                                    Sesión: <span t-out="session_data['session'].name"/>
                                </h3>

                                <!-- Información de la sesión -->
                                <div class="mb-3">
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Punto de Venta:</strong> <span t-out="session_data['session'].config_id.name"/><br/>
                                            <strong>Usuario:</strong> <span t-out="session_data['session'].user_id.name"/><br/>
                                            <strong>Fecha Inicio:</strong> <span t-out="session_data['session'].start_at" t-options="{'widget': 'datetime'}"/><br/>
                                        </div>
                                        <div class="col-6">
                                            <strong>Estado:</strong> <span t-out="dict(session_data['session']._fields['state'].selection).get(session_data['session'].state)"/><br/>
                                            <t t-if="session_data['session'].stop_at">
                                                <strong>Fecha Cierre:</strong> <span t-out="session_data['session'].stop_at" t-options="{'widget': 'datetime'}"/><br/>
                                            </t>
                                            <strong>Total Pedidos:</strong> <span t-out="session_data['total_orders']"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Resumen de la sesión -->
                                <div class="mb-3">
                                    <table class="table table-sm table-bordered">
                                        <tr class="table-info">
                                            <th>Total Sesión:</th>
                                            <th class="text-right">
                                                <span t-out="session_data['total_amount']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                            </th>
                                            <th>Impuestos:</th>
                                            <th class="text-right">
                                                <span t-out="session_data['total_tax']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                            </th>
                                        </tr>
                                    </table>
                                </div>

                                <!-- Detalle de pedidos (solo si es informe detallado) -->
                                <t t-if="data['report_type'] == 'detailed'">
                                    <h5 class="mt-3 mb-2">Detalle de Pedidos</h5>
                                    <t t-foreach="session_data['orders']" t-as="order">
                                        <div class="mb-4 border-top pt-3 order-block">
                                            <!-- Cabecera del pedido -->
                                            <div class="row mb-2">
                                                <div class="col-8">
                                                    <strong>Pedido:</strong> <span t-out="order['name']"/>
                                                    <t t-if="order['pos_reference']">
                                                        (<span t-out="order['pos_reference']"/>)
                                                    </t>
                                                    <br/>
                                                    <strong>Cliente:</strong> <span t-out="order['partner']"/>
                                                </div>
                                                <div class="col-4 text-right">
                                                    <strong>Fecha:</strong> <span t-out="order['date_order']" t-options="{'widget': 'datetime'}"/><br/>
                                                    <strong>Cajero:</strong> <span t-out="order['user']"/>
                                                </div>
                                            </div>

                                            <!-- Líneas del pedido -->
                                            <table class="table table-sm">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th class="text-right">Cantidad</th>
                                                        <th class="text-right">Precio Unit.</th>
                                                        <th class="text-right">Dto. %</th>
                                                        <th class="text-right">Subtotal</th>
                                                        <th class="text-right">Impuestos</th>
                                                        <th class="text-right">Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="order['lines']" t-as="line">
                                                        <td><span t-out="line['product']"/></td>
                                                        <td class="text-right"><span t-out="line['qty']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                                        <td class="text-right">
                                                            <span t-out="line['price_unit']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-out="line['discount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-out="line['subtotal']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-out="line['tax_amount']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-out="line['total']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <tfoot>
                                                    <tr class="table-light">
                                                        <td colspan="4" class="text-right"><strong>Subtotal:</strong></td>
                                                        <td class="text-right">
                                                            <strong>
                                                                <span t-out="order['amount_subtotal']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                            </strong>
                                                        </td>
                                                        <td class="text-right">
                                                            <strong>
                                                                <span t-out="order['amount_tax']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                            </strong>
                                                        </td>
                                                        <td class="text-right">
                                                            <strong>
                                                                <span t-out="order['amount_total']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                            </strong>
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>

                                            <!-- Pagos del pedido -->
                                            <div class="mb-2">
                                                <strong>Métodos de Pago:</strong>
                                                <table class="table table-sm table-bordered" style="width: 40%;">
                                                    <tbody>
                                                        <tr t-foreach="order['payments']" t-as="payment">
                                                            <td><span t-out="payment['method']"/></td>
                                                            <td class="text-right">
                                                                <span t-out="payment['amount']" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </t>
                                </t>

                                <!-- Resumen de pagos de la sesión -->
                                <div class="mt-3">
                                    <h5>Resumen de Pagos - Sesión</h5>
                                    <table class="table table-sm table-bordered" style="width: 50%;">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Método de Pago</th>
                                                <th class="text-right">Importe</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="session_data['payment_summary'].items()" t-as="payment">
                                                <td><span t-out="payment[0]"/></td>
                                                <td class="text-right">
                                                    <span t-out="payment[1]" t-options="{'widget': 'monetary', 'display_currency': session_data['session'].currency_id}"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

