<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de formulario de res.partner para agregar el smart button -->
    <record id="view_partner_form_client_sessions" model="ir.ui.view">
        <field name="name">res.partner.form.client.sessions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_client_sessions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o">
                    <field name="client_sessions_count" widget="statinfo" string="Sesiones"/>
                </button>
            </div>
        </field>
    </record>
</odoo>

