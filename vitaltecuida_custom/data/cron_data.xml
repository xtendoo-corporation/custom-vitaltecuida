<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cron Job para enviar notificaciones de expiración de monederos -->
        <record id="cron_ewallet_expiry_notifications" model="ir.cron">
            <field name="name">Notificaciones de Expiración de Monederos Electrónicos</field>
            <field name="model_id" ref="loyalty.model_loyalty_card"/>
            <field name="code">model._send_expiry_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron Job para enviar felicitaciones de cumpleaños con tarjetas regalo -->
        <record id="cron_birthday_gift_notifications" model="ir.cron">
            <field name="name">Felicitaciones de Cumpleaños con Tarjetas Regalo</field>
            <field name="model_id" ref="loyalty.model_loyalty_card"/>
            <field name="code">model._send_birthday_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
