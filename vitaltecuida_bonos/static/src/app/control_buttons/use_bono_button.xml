<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="partner"
                    class="btn btn-light btn-lg lh-lg"
                    t-on-click="() => this.clickUseBono()">
                <i class="fa fa-ticket me-1"/>
                Usar bono
            </button>
        </xpath>
        <xpath expr="//div[contains(@class, 'control-buttons-modal')]" position="inside">
            <button t-if="partner"
                    class="btn btn-secondary btn-lg py-5"
                    t-on-click="() => this.clickUseBono()">
                <i class="fa fa-ticket me-1"/>
                Usar bono
            </button>
        </xpath>
    </t>
</templates>

