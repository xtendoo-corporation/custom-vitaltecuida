<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vitaltecuida_bono_balance_tree" model="ir.ui.view">
        <field name="name">vitaltecuida.bono.balance.tree</field>
        <field name="model">vitaltecuida.bono.balance</field>
        <field name="arch" type="xml">
            <list string="Bonos de clientes">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="total_uses"/>
                <field name="remaining_uses"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_vitaltecuida_bono_balance_form" model="ir.ui.view">
        <field name="name">vitaltecuida.bono.balance.form</field>
        <field name="model">vitaltecuida.bono.balance</field>
        <field name="arch" type="xml">
            <form string="Bono de cliente">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="total_uses" readonly="1"/>
                            <field name="remaining_uses" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field name="move_ids" readonly="1">
                                <list string="Movimientos">
                                    <field name="create_date" string="Fecha"/>
                                    <field name="move_type"/>
                                    <field name="quantity"/>
                                    <field name="remaining_after"/>
                                    <field name="order_id"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vitaltecuida_bono_balance_search" model="ir.ui.view">
        <field name="name">vitaltecuida.bono.balance.search</field>
        <field name="model">vitaltecuida.bono.balance</field>
        <field name="arch" type="xml">
            <search string="Buscar bonos">
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="available" string="Con usos" domain="[('remaining_uses', '&gt;', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Bono" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vitaltecuida_bono_balance" model="ir.actions.act_window">
        <field name="name">Bonos</field>
        <field name="res_model">vitaltecuida.bono.balance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vitaltecuida_bono_balance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea o consulta los bonos de tus clientes.</p>
        </field>
    </record>
</odoo>

